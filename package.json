{
  "name": "compilix",
  "version": "1.0.0",
  "description": "A modern, deployment-friendly online compiler with a LeetCode-inspired user interface",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "test": "npm run test --workspace=backend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "build:runners": "node scripts/build-runners.js",
    "check:env": "node scripts/check-environment.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "compiler",
    "docker",
    "monaco-editor",
    "code-execution",
    "express",
    "vite"
  ],
  "author": "Compilix Team",
  "license": "MIT"
}
